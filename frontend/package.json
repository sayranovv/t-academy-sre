{
  "name": "equipment-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "types:api": "openapi-typescript http://api:8000/openapi.json -o src/generated/api.d.ts",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@primeuix/themes": "3.0.1",
    "primeicons": "^7.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.43",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.5.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.1",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.0"
  }
}
